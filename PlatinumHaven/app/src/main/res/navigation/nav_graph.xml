<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment"
        android:name="com.platinumhaven.app.ui.LoginFragment"
        android:label=" " tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_login_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment"/>
    </fragment>

    <fragment android:id="@+id/registerFragment"
        android:name="com.platinumhaven.app.ui.RegisterFragment"
        android:label=" " tools:layout="@layout/fragment_register">
        <action android:id="@+id/action_register_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_register_success" app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/homeFragment"
        android:name="com.platinumhaven.app.ui.HomeFragment"
        android:label=" " tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_detail" app:destination="@id/roomDetailFragment"/>
    </fragment>

    <fragment android:id="@+id/roomDetailFragment"
        android:name="com.platinumhaven.app.ui.RoomDetailFragment"
        android:label=" " tools:layout="@layout/fragment_room_detail">
        <argument android:name="roomId" app:argType="string"/>
        <argument android:name="roomName" app:argType="string"/>
        <argument android:name="roomPrice" app:argType="float"/>
        <argument android:name="roomType" app:argType="string"/>
        <argument android:name="roomBeds" app:argType="integer" android:defaultValue="1"/>
        <argument android:name="roomGuests" app:argType="integer" android:defaultValue="2"/>
        <argument android:name="roomStatus" app:argType="string"/>
        <argument android:name="roomImage" app:argType="string" android:defaultValue=""/>
        <argument android:name="roomDesc" app:argType="string" android:defaultValue=""/>
        <action android:id="@+id/action_detail_to_booking_step1" app:destination="@id/bookingStep1Fragment"/>
    </fragment>

    <fragment android:id="@+id/bookingStep1Fragment"
        android:name="com.platinumhaven.app.ui.BookingStep1Fragment"
        android:label=" " tools:layout="@layout/fragment_booking_step1">
        <argument android:name="roomId" app:argType="string"/>
        <argument android:name="roomName" app:argType="string"/>
        <argument android:name="roomPrice" app:argType="float"/>
        <argument android:name="roomImage" app:argType="string" android:defaultValue=""/>
        <argument android:name="roomGuests" app:argType="integer" android:defaultValue="2"/>
        <action android:id="@+id/action_step1_to_step2" app:destination="@id/bookingStep2Fragment"/>
    </fragment>

    <fragment android:id="@+id/bookingStep2Fragment"
        android:name="com.platinumhaven.app.ui.BookingStep2Fragment"
        android:label=" " tools:layout="@layout/fragment_booking_step2">
        <argument android:name="roomId" app:argType="string"/>
        <argument android:name="roomName" app:argType="string"/>
        <argument android:name="roomPrice" app:argType="float"/>
        <argument android:name="roomImage" app:argType="string" android:defaultValue=""/>
        <argument android:name="checkIn" app:argType="string"/>
        <argument android:name="checkOut" app:argType="string"/>
        <argument android:name="guests" app:argType="integer" android:defaultValue="1"/>
        <argument android:name="adults" app:argType="integer" android:defaultValue="1"/>
        <argument android:name="children" app:argType="integer" android:defaultValue="0"/>
        <argument android:name="specialRequests" app:argType="string" android:defaultValue=""/>
        <argument android:name="totalPrice" app:argType="float" android:defaultValue="0"/>
        <action android:id="@+id/action_step2_to_step3" app:destination="@id/bookingStep3Fragment"/>
    </fragment>

    <fragment android:id="@+id/bookingStep3Fragment"
        android:name="com.platinumhaven.app.ui.BookingStep3Fragment"
        android:label=" " tools:layout="@layout/fragment_booking_step3">
        <argument android:name="roomId" app:argType="string"/>
        <argument android:name="roomName" app:argType="string"/>
        <argument android:name="roomImage" app:argType="string" android:defaultValue=""/>
        <argument android:name="checkIn" app:argType="string"/>
        <argument android:name="checkOut" app:argType="string"/>
        <argument android:name="guests" app:argType="integer" android:defaultValue="1"/>
        <argument android:name="adults" app:argType="integer" android:defaultValue="1"/>
        <argument android:name="children" app:argType="integer" android:defaultValue="0"/>
        <argument android:name="specialRequests" app:argType="string" android:defaultValue=""/>
        <argument android:name="totalPrice" app:argType="float" android:defaultValue="0"/>
        <argument android:name="addonIds" app:argType="string" android:defaultValue=""/>
        <action android:id="@+id/action_step3_to_confirmation" app:destination="@id/confirmationFragment"/>
    </fragment>

    <fragment android:id="@+id/confirmationFragment"
        android:name="com.platinumhaven.app.ui.ConfirmationFragment"
        android:label=" " tools:layout="@layout/fragment_confirmation">
        <argument android:name="reservationNo" app:argType="string" android:defaultValue=""/>
        <argument android:name="roomName" app:argType="string" android:defaultValue=""/>
        <argument android:name="checkIn" app:argType="string" android:defaultValue=""/>
        <argument android:name="checkOut" app:argType="string" android:defaultValue=""/>
        <argument android:name="total" app:argType="string" android:defaultValue=""/>
        <action android:id="@+id/action_confirmation_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_confirmation_to_bookings" app:destination="@id/bookingsFragment"/>
    </fragment>

    <fragment android:id="@+id/bookingsFragment"
        android:name="com.platinumhaven.app.ui.BookingsFragment"
        android:label=" " tools:layout="@layout/fragment_bookings">
        <action android:id="@+id/action_bookings_to_feedback" app:destination="@id/feedbackFragment"/>
        <argument android:name="reservationId" app:argType="string" android:defaultValue=""/>
    </fragment>

    <fragment android:id="@+id/feedbackFragment"
        android:name="com.platinumhaven.app.ui.FeedbackFragment"
        android:label=" " tools:layout="@layout/fragment_feedback">
        <argument android:name="reservationId" app:argType="string"/>
        <action android:id="@+id/action_feedback_to_bookings" app:destination="@id/bookingsFragment"
            app:popUpTo="@id/bookingsFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/chatFragment"
        android:name="com.platinumhaven.app.ui.ChatFragment"
        android:label=" " tools:layout="@layout/fragment_chat"/>

    <fragment android:id="@+id/profileFragment"
        android:name="com.platinumhaven.app.ui.ProfileFragment"
        android:label=" " tools:layout="@layout/fragment_profile"/>

    <fragment android:id="@+id/personalInfoFragment"
        android:name="com.platinumhaven.app.ui.PersonalInfoFragment"
        android:label=" " tools:layout="@layout/fragment_personal_info"/>
</navigation>
